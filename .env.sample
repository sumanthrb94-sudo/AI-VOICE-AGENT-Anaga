# Vaak AI — environment sample (WP-0). Copy to .env and fill. NEVER commit real secrets.

# --- Caller agent (dial queue consumer, caller-agent/) ---
TELEPHONY_PROVIDER=mock    # mock | plivo | exotel — mock CANNOT place a real call
MEDIA_SERVER_URL=          # WebSocket media server; adapters refuse to dial without it
VAAK_API_BASE_URL=         # where the caller agent reaches /api/anaga/turn + /api/calls/outcome
MAX_CONCURRENT_CALLS=25
CALL_MAX_TURNS=24
CALL_MAX_SECONDS=300
DIAL_RING_TIMEOUT_SEC=30
ENDPOINT_SILENCE_MS=900    # higher than the ~500ms Western default: code-mixed speech pauses longer
MAX_UTTERANCE_MS=20000
MIN_SPEECH_MS=200
TELEPHONY_SAMPLE_RATE=8000
STT_PROVIDER=sarvam        # sarvam | mock
SARVAM_STT_MODEL=saaras:v2
TELEPHONY_STATUS_URL=      # telephony posts call lifecycle events here
EXOTEL_SUBDOMAIN=api.in.exotel.com
EXOTEL_API_KEY=

# --- Rate limiting (per-instance dampener, NOT access control) ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_INTAKE=60
RATE_LIMIT_META=300
RATE_LIMIT_OUTCOME=120

# --- Telephony (160-series, compliant) ---
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
EXOTEL_SID=
EXOTEL_TOKEN=
OUTBOUND_CALLER_ID=        # must be a 160-series number

# --- Agent identity & voice ---
AGENT_NAME=Anaga
AGENT_PERSONA=caller-agent/flows/anaga.persona.json
TTS_VOICE_GENDER=female
TTS_SPEAKER=anushka        # Sarvam Bulbul female voice; verify id against current Sarvam docs

# --- Speech (provider-abstracted; Sarvam default) ---
# SARVAM_API_KEY powers the live "Talk to Anaga" voices via /api/tts (Bulbul).
# Set it in Vercel (server-side only). Without it, the browser TTS fallback is used.
SARVAM_API_KEY=
TTS_PROVIDER=sarvam        # sarvam | (future: elevenlabs, azure, gcloud)
SARVAM_TTS_MODEL=bulbul:v2
# AI4BHARAT_API_KEY=       # alternate STT/TTS adapter

# --- LLM (provider-abstracted) ---
LLM_PROVIDER=gemini        # gemini | hosted | ollama | vllm  (Anaga call-brain default: gemini)
LLM_API_KEY=
LLM_BASE_URL=

# Google Gemini (powers the live "Talk to Anaga" call brain + call review).
# Set this in Vercel Project Settings → Environment Variables (server-side only;
# it must NEVER be exposed to the browser). Verify the model name against current
# Google AI docs. If unset, the call demo falls back to the on-device rule engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Integrations: shared secret for OUR inbound endpoints ---
# Guards /api/leads/intake and /api/calls/outcome. Fails closed: if this is
# unset, those endpoints authorize nobody (503 auth_not_configured).
INTEGRATIONS_API_KEY=
PUBLIC_BASE_URL=           # e.g. https://vaak.example.com — used to build callback URLs

# --- Meta (Facebook / Instagram) Lead Ads ---
# Webhook: POST/GET https://<PUBLIC_BASE_URL>/api/integrations/meta/leads
META_APP_SECRET=           # verifies X-Hub-Signature-256; without it every POST is rejected
META_VERIFY_TOKEN=         # any random string; paste the same one into the Meta webhook UI
META_PAGE_ACCESS_TOKEN=    # long-lived Page token with leads_retrieval + pages_manage_ads
META_GRAPH_VERSION=v21.0

# --- CRM (provider-abstracted; see api/_lib/integrations/crm.js) ---
CRM_PROVIDER=none          # none | webhook | hubspot | zoho
CRM_DND_PROPERTY=vaak_dnd  # the do-not-call field/property name in your CRM

# generic webhook CRM (Salesforce Flow / Zapier / Make / n8n / your own endpoint)
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=        # we sign the body as X-Vaak-Signature-256: sha256=<hex>

# HubSpot (private app token; scopes: contacts read+write, notes write)
HUBSPOT_ACCESS_TOKEN=

# Zoho CRM (India DC defaults; ZOHO_ACCESS_TOKEN alone is fine for a quick test)
ZOHO_REFRESH_TOKEN=
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_ACCESS_TOKEN=
ZOHO_API_DOMAIN=https://www.zohoapis.in
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.in

# --- Dial queue (hand-off to the orchestrator / caller agent, WP-2/WP-3) ---
DIAL_QUEUE_URL=            # unset => leads are accepted + gated but not dialed
DIAL_QUEUE_SECRET=         # we sign the job as X-Vaak-Signature-256: sha256=<hex>
DIAL_MAX_ATTEMPTS=3

# --- Compliance (fails closed: no creds => no dial) ---
COMPLIANCE_MODE=strict     # strict | dev  — 'dev' allows dialing without a DND scrub. NEVER in prod.
DLT_PRINCIPAL_ENTITY_ID=
DLT_HEADER=
DND_SCRUB_URL=             # GET ?phone=+91… -> { "dnd": true|false }
DND_SCRUB_API_KEY=
LEAD_CONSENT_WINDOW_DAYS=90  # a Meta form submit older than this is no longer a basis to call
CALLING_WINDOW_START_IST=9   # outbound telemarketing window (IST)
CALLING_WINDOW_END_IST=21
DEFAULT_COUNTRY_CODE=91
RECORDING_BUCKET=          # Indian-region object storage
RECORDING_RETENTION_DAYS=90

# --- Datastore ---
DATABASE_URL=
# Durable do-not-call list. GET ?phone=+91… -> { "suppressed": true|false }
#                           POST { phone, reason, at, source } -> 2xx
# Unset => opt-outs only hold for the life of a warm serverless instance.
SUPPRESSION_LIST_URL=
SUPPRESSION_LIST_TOKEN=

# --- Observability ---
OTEL_EXPORTER_OTLP_ENDPOINT=
