{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm build",
  "outputDirectory": "out",
  "regions": ["bom1"],
  "functions": {
    "api/**/*.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/calls/recording",
      "destination": "/api/calls/transcript?action=recording"
    },
    {
      "source": "/api/calls/demo",
      "destination": "/api/calls/transcript?action=demo"
    },
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    }
  ]
}
