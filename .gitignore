# secrets & env
.env
.env.local
*.local

# service-account / credential files — NEVER commit one.
# A Firebase Admin key grants full project access and bypasses ALL Firestore
# security rules. It belongs in an env var or a secret manager, never in git.
*serviceAccount*.json
*service-account*.json
*firebase-adminsdk*.json
*-adminsdk-*.json
gcp-credentials*.json
credentials.json
.secrets/

# python
__pycache__/
*.py[cod]
.venv/
venv/

# node
node_modules/
dist/

# static build output (generated by scripts/build-static.sh)
public/
.vercel/

# graphify knowledge graph — generated, rebuild with `graphify update .`
graphify-out/

# .NET
bin/
obj/

# os / editor
.DS_Store
.idea/
.vscode/

# Ruflo local secrets and runtime data
.env.*.local
.claude-flow/data/
.claude-flow/logs/
.claude-flow/sessions/
.claude-flow/metrics/
.claude-flow/security/
.claude-flow/daemon.pid
.claude-flow/daemon-state.json
.claude-flow/harness-active-policy.json
.claude-flow/policy/
.claude/.proven-config-version
.claude/proven-config.json

# Ruflo swarm telemetry — SQLite written on every session, never source
.swarm/
deploy/indicf5/voices/*
!deploy/indicf5/voices/README.md
